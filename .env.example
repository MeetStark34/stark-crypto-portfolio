NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Lm6HazldHUzB4-tCf1dK7g_P5cpBfl1

# Server-only CoinGecko Demo API key. Market quotes are unavailable until set.
