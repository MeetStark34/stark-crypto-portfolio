export type PortfolioPrice = { amount: string | null; status?: "fresh" | "stale" | "unavailable"; updatedAt?: string | null; cachedAt?: string | null };
export type PortfolioTransactionInput = { asset_symbol: string; fiat_currency: string; crypto_amount: string; total_fiat_amount: string; fee_fiat_amount: string; purchase_value_fiat?: string | null };
export type PortfolioHolding = { symbol: string; name: string; amount: string; totalInvested: string; fees: string; purchaseValue: string; currentPrice: string | null; currentValue: string | null; profitLoss: string | null; profitLossPercent: string | null; averagePurchasePrice: string; averageCostIncludingFees: string; allocationPercent: string | null; priceStatus: "fresh" | "stale" | "unavailable"; priceUpdatedAt: string | null };
export type PortfolioSummary = { currency: string; complete: boolean; priceStatus: "incomplete" | "stale" | "fresh"; totalInvested: string; totalFees: string; purchaseValue: string; currentValue: string | null; profitLoss: string | null; profitLossPercent: string | null; holdings: PortfolioHolding[]; bestPerforming: string | null; worstPerforming: string | null };
export function calculatePortfolio(transactions: PortfolioTransactionInput[], pricesByCurrency?: Record<string, Record<string, PortfolioPrice>>): PortfolioSummary[];
